[
  {
    "bugId": "bug-treehouse-typo-weekend",
    "sessionId": "golden-bug-treehouse-typo-weekend",
    "turns": [
      {
        "message": "Is treehouse 3 available today?",
        "expectMeta": { "route": "availability" },
        "expectReplyType": "availability",
        "expectOneOfIncludes": ["Treehouse #3", "Book now:", "already booked", "available"],
        "forbidIncludes": ["Here’s a quick, friendly overview"]
      },
      {
        "message": "What about a weekened in march?",
        "expectMeta": { "route": "availability" },
        "expectReplyType": "availability",
        "expectOneOfIncludes": ["March", "weekend", "Book now:"],
        "forbidIncludes": ["Here’s a quick, friendly overview", "Would you like me to check availability or answer anything else?"]
      }
    ]
  },
  {
    "bugId": "bug-hot-tub-filter-preserve",
